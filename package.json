{
  "name": "laserverse",
  "version": "0.1.0",
  "private": true,
  "description": "PHOTON TO PRODUCT — LASERVERSE: interactive laser technology & engineering platform built from The Complete Laser Handbook.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "STATIC_EXPORT=1 NEXT_PUBLIC_BASE_PATH=/LASERVERSE next build && touch out/.nojekyll",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ingest": "python3 -I scripts/ingest/ingest_handbook.py",
    "validate:content": "vitest run tests/unit/content"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "framer-motion": "12.43.0",
    "geist": "1.8.1",
    "katex": "0.16.47",
    "lucide-react": "0.544.0",
    "minisearch": "7.2.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "three": "0.180.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/katex": "0.16.7",
    "@types/node": "22.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/three": "0.180.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
